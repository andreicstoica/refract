sequenceDiagram
  box lightgreen Hooks
    participant Triggers as useProdTriggers
  end
  box lightyellow Rules
    participant Rules as prodTriggerRules
  end
  box plum Queue
    participant Queue as ProdsProvider
  end

  Note over Triggers: Receives { text, sentences, config } from TextInput
  Note over Triggers: Check: prodsEnabled + hasLastSentence + cooldown cleared
  
  Triggers->>Rules: shouldTriggerProd(cooldownMs, minChars)
  Note over Rules: Requires 50 chars overall OR 20 chars in last sentence
  
  alt cooldown active or insufficient text
    Note over Triggers: Wait...
  else cooldown cleared
    Triggers->>Rules: getProdTriggerReason(lastTriggerPos, charTrigger)
    Note over Rules: Priority: punctuation → softComma (>=25 overall + >=8 since last) → charThreshold
    
    alt TRIGGER: Terminal punctuation (.!?)
      Rules-->>Triggers: "punctuation"
      Triggers->>Queue: enqueueSentence(fullText, lastSentence)
    else TRIGGER: Soft comma + conditions
      Rules-->>Triggers: "softComma"
      Triggers->>Queue: enqueueSentence(fullText, lastSentence)
    else TRIGGER: Character threshold reached
      Rules-->>Triggers: "charThreshold"
      Triggers->>Queue: enqueueSentence(fullText, lastSentence)
    else No immediate trigger
      Triggers->>Triggers: scheduleSettlingTimer(settlingMs)
      Note over Triggers: After settling delay, re-check shouldTriggerProd
      alt still valid after settling
        Triggers->>Queue: enqueueSentence(fullText, lastSentence)
      end
    end
  end
  
  Note over Triggers: WATCHDOG: 6s idle forces triggerProd(force=true) then locks until new input
  
  Queue->>Queue: Apply guardrails (shouldProcessSentence, TTLs, dedup)
  alt sentence passes guards
    Queue->>Queue: Rate limit then API call
  end